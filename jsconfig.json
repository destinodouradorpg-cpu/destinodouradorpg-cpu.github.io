    "compilerOptions": {
        "checkJs": true,
        "target": "ES2022",
        "lib": ["ES2022", "DOM"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "allowJs": true,

        "baseUrl": ".",
        "paths": {
            "/components/*": ["components/*"]
        }
    },
    "exclude": ["node_modules"]
}